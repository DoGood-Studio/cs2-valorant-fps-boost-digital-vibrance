<Window x:Class="GameColorGuard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:GameColorGuard.Controls"
        Title="Game Color Guard"
        Width="1160" Height="800" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Bg0Brush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource BodyFont}" FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Icon="pack://application:,,,/assets/app-icon.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" Background="{StaticResource Bg0Brush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Ortam ışığı -->
            <Rectangle Grid.RowSpan="2" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.80,-0.08" GradientOrigin="0.80,-0.08" RadiusX="0.55" RadiusY="0.80">
                        <GradientStop Color="#1FFF7A1A" Offset="0"/>
                        <GradientStop Color="#0AFF7A1A" Offset="0.5"/>
                        <GradientStop Color="#00FF7A1A" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- ============ Başlık çubuğu ============ -->
            <Grid Grid.Row="0" Margin="20,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Source>
                            <BitmapImage UriSource="pack://application:,,,/assets/app-logo.png" DecodePixelWidth="64"/>
                        </Image.Source>
                    </Image>
                    <TextBlock Text="Game Color Guard" Margin="12,0,0,0" FontSize="14" FontWeight="SemiBold"
                               FontFamily="{StaticResource DisplayFont}" VerticalAlignment="Center"/>
                    <Border Style="{StaticResource Chip}" Margin="10,0,0,0" Padding="7,2" VerticalAlignment="Center">
                        <TextBlock Text="v3.2" FontSize="11" Foreground="{StaticResource Text2Brush}"/>
                    </Border>
                </StackPanel>
                <!-- Sayfa sekmeleri -->
                <StackPanel x:Name="NavBar" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Margin="16,0">
                    <RadioButton x:Name="NavColor" Style="{StaticResource NavTab}" GroupName="Nav" Tag="color" IsChecked="True"
                                 Checked="Nav_Checked" AutomationProperties.Name="Renk">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE790;" Style="{StaticResource Icon}" FontSize="13"/>
                            <TextBlock Text="Renk" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavBoost" Style="{StaticResource NavTab}" GroupName="Nav" Tag="boost"
                                 Checked="Nav_Checked" AutomationProperties.Name="FPS Boost">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="13"/>
                            <TextBlock Text="FPS Boost" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavBackground" Style="{StaticResource NavTab}" GroupName="Nav" Tag="background"
                                 Checked="Nav_Checked" AutomationProperties.Name="Arka plan">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7C4;" Style="{StaticResource Icon}" FontSize="13"/>
                            <TextBlock Text="Arka plan" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavPro" Style="{StaticResource NavTab}" GroupName="Nav" Tag="pro"
                                 Checked="Nav_Checked" AutomationProperties.Name="Pro ayarlar">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE734;" Style="{StaticResource Icon}" FontSize="13"/>
                            <TextBlock Text="Pro ayarlar" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSystem" Style="{StaticResource NavTab}" GroupName="Nav" Tag="system"
                                 Checked="Nav_Checked" AutomationProperties.Name="Sistem">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE977;" Style="{StaticResource Icon}" FontSize="13"/>
                            <TextBlock Text="Sistem" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ChromeButton}" Click="Minimize_Click" ToolTip="Simge durumuna küçült"
                            AutomationProperties.Name="Küçült">
                        <TextBlock Text="&#xE921;" Style="{StaticResource Icon}" FontSize="10"/>
                    </Button>
                    <Button Style="{StaticResource ChromeButton}" Click="MaxRestore_Click" ToolTip="Büyüt / geri al"
                            AutomationProperties.Name="Büyüt">
                        <TextBlock x:Name="MaxRestoreGlyph" Text="&#xE922;" Style="{StaticResource Icon}" FontSize="10"/>
                    </Button>
                    <Button Style="{StaticResource ChromeCloseButton}" Click="Close_Click" ToolTip="Sistem tepsisine gizle"
                            AutomationProperties.Name="Kapat">
                        <TextBlock Text="&#xE8BB;" Style="{StaticResource Icon}" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============ Gövde ============ -->
            <Grid Grid.Row="1" Margin="16,2,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="318"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ============ Kenar çubuğu ============ -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Canlı durum -->
                    <Border x:Name="HeroCard" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <Rectangle x:Name="HeroGlow" RadiusX="15" RadiusY="15" IsHitTestVisible="False"/>
                            <Grid Margin="20,18,20,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="CANLI DURUM" Style="{StaticResource Eyebrow}"/>
                                <TextBlock x:Name="HeroTitle" Grid.Row="1" Text="Beklemede" FontSize="25" FontWeight="SemiBold"
                                           FontFamily="{StaticResource DisplayFont}" Margin="0,6,0,0"
                                           TextOptions.TextFormattingMode="Ideal"/>
                                <c:StatusRing x:Name="HeroRing" Grid.Column="1" Grid.RowSpan="2" Width="60" Height="60"
                                              VerticalAlignment="Top" Margin="12,0,0,0"/>
                                <TextBlock x:Name="HeroDetail" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0"
                                           Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap" LineHeight="19"/>
                                <WrapPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,14,0,0">
                                    <Border Style="{StaticResource Chip}" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="12"
                                                       Foreground="{StaticResource Text2Brush}"/>
                                            <TextBlock x:Name="DisplayChipText" Text="1 ekran" Margin="7,0,0,0" FontSize="11.5"
                                                       Foreground="{StaticResource Text2Brush}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Chip}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="NvidiaChipDot" Width="6" Height="6" VerticalAlignment="Center"
                                                     Fill="{StaticResource SuccessBrush}"/>
                                            <TextBlock x:Name="NvidiaChipText" Text="Renk motoru hazır" Margin="7,0,0,0" FontSize="11.5"
                                                       Foreground="{StaticResource Text2Brush}"/>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- İzlenen oyunlar -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="20,18,20,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="İzlenen oyunlar" Style="{StaticResource CardTitle}"/>
                                    <Border Style="{StaticResource Chip}" Margin="9,0,0,0" Padding="7,1" VerticalAlignment="Center">
                                        <TextBlock x:Name="GamesCountText" Text="0" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Text2Brush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Odaktaki oyuna profil otomatik uygulanır" Style="{StaticResource CardSub}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" Margin="10,0,6,0" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                                <Grid>
                                    <ItemsControl x:Name="GameItems" Margin="0,0,4,0" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Row" CornerRadius="11" Padding="10,9" Margin="0,1"
                                                        Background="Transparent">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="38" Height="38" CornerRadius="10" BorderThickness="1"
                                                                Background="{Binding TileBrush}" BorderBrush="{Binding TileBorderBrush}">
                                                            <Grid>
                                                                <Image Source="{Binding Icon}" Width="26" Height="26"
                                                                       Visibility="{Binding IconVisibility}"
                                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                <TextBlock Text="{Binding Monogram}" Foreground="{Binding AccentBrush}"
                                                                           FontSize="12.5" FontWeight="Bold" Visibility="{Binding MonogramVisibility}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Executable}" FontSize="11.5" Margin="0,2,0,0"
                                                                       Foreground="{StaticResource Text3Brush}" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="2" CornerRadius="7" Padding="8,3" VerticalAlignment="Center"
                                                                Background="{Binding StatusBackground}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                                                           FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Button x:Name="RemoveButton" Grid.Column="3" Style="{StaticResource IconButton}"
                                                                Margin="4,0,-4,0" Click="RemoveGame_Click" Visibility="Hidden"
                                                                ToolTip="Listeden çıkar" AutomationProperties.Name="Listeden çıkar">
                                                            <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource Surface2Brush}"/>
                                                        <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="GamesEmptyHint" Visibility="Collapsed" Margin="10,6" TextWrapping="Wrap"
                                               Style="{StaticResource CardSub}"
                                               Text="Henüz izlenen oyun yok. Aşağıdan oyunun .exe dosyasını ekleyin."/>
                                </Grid>
                            </ScrollViewer>

                            <Button Grid.Row="2" Style="{StaticResource DashedButton}" Height="42" Margin="16,10,16,16"
                                    Click="AddGame_Click" AutomationProperties.Name="Oyun ekle">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12"/>
                                    <TextBlock Text="Oyun ekle" Margin="9,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Başlangıç -->
                    <Border Grid.Row="4" Style="{StaticResource Card}" Padding="20,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="AYARLAR" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
                                <!-- Dil seçici: kart yüksekliğini artırmamak için başlık satırında, liste açılır pencerede -->
                                <Button x:Name="LanguageButton" Style="{StaticResource GhostButton}" Height="30" Padding="10,0"
                                        HorizontalAlignment="Right" Margin="0,-9,-10,-9" Click="LanguageButton_Click"
                                        ToolTip="Dil" AutomationProperties.Name="Dil">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="12"/>
                                        <TextBlock x:Name="LanguageButtonText" Margin="7,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="9" Margin="6,1,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Popup x:Name="LanguagePopup" PlacementTarget="{Binding ElementName=LanguageButton}" Placement="Bottom"
                                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="None">
                                    <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource StrokeStrongBrush}"
                                            BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,4,0,0">
                                        <StackPanel x:Name="LanguagePanel" MinWidth="150"/>
                                    </Border>
                                </Popup>
                            </Grid>
                            <Grid>
                                <StackPanel Margin="0,0,56,0">
                                    <TextBlock Text="Alt+Tab'da profili koru" FontWeight="SemiBold"/>
                                    <TextBlock Text="Oyun ekranda göründükçe renkler açık kalır" Style="{StaticResource CardSub}"
                                               Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleButton x:Name="KeepVisibleToggle" Style="{StaticResource Switch}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              AutomationProperties.Name="Alt+Tab'da profili koru"/>
                            </Grid>
                            <Rectangle Height="1" Fill="{StaticResource StrokeBrush}" Margin="0,13"/>
                            <Grid>
                                <StackPanel Margin="0,0,56,0">
                                    <TextBlock Text="Windows ile başlat" FontWeight="SemiBold"/>
                                    <TextBlock Text="Oturum açılınca tepside çalışır" Style="{StaticResource CardSub}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ToggleButton x:Name="StartWithWindowsToggle" Style="{StaticResource Switch}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              AutomationProperties.Name="Windows ile başlat"/>
                            </Grid>
                            <Rectangle Height="1" Fill="{StaticResource StrokeBrush}" Margin="0,13"/>
                            <Grid>
                                <StackPanel Margin="0,0,56,0">
                                    <TextBlock Text="Tepside başlat" FontWeight="SemiBold"/>
                                    <TextBlock Text="Pencere açılmadan arka planda başlar" Style="{StaticResource CardSub}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ToggleButton x:Name="StartMinimizedToggle" Style="{StaticResource Switch}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              AutomationProperties.Name="Tepside başlat"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Geliştirici imzası ve hafiflik notu -->
                    <StackPanel Grid.Row="5" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Geliştirici" FontSize="11.5" Foreground="{StaticResource Text3Brush}"/>
                        <TextBlock Text="DoGood Studio" FontSize="11.5" FontWeight="SemiBold" Margin="5,0,0,0"
                                   Foreground="{StaticResource Ember300Brush}"/>
                        <TextBlock Text="· v3.2" FontSize="11.5" Margin="5,0,0,0" Foreground="{StaticResource Text3Brush}"/>
                    </StackPanel>
                    <TextBlock Text="Arka planda RAM kullanmaması için gereksiz animasyon ve öğelerden arındırılmıştır." FontSize="10.5" Margin="8,4,8,0" TextAlignment="Center"
                               TextWrapping="Wrap" Foreground="{StaticResource Text3Brush}"/>
                    </StackPanel>
                </Grid>

                <!-- ============ Ana alan: Renk sayfası ============ -->
                <Grid x:Name="ColorPage" Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                        <StackPanel Margin="0,0,12,0" MaxWidth="1060">

                            <!-- Sayfa başlığı -->
                            <Grid Margin="4,4,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Görüntü profili" FontSize="27" FontWeight="SemiBold" VerticalAlignment="Center"
                                           FontFamily="{StaticResource DisplayFont}" TextOptions.TextFormattingMode="Ideal"/>
                                <TextBlock x:Name="ColorPageSubtitle" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0"
                                           Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Border Style="{StaticResource Chip}" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="11"
                                                       Foreground="{StaticResource SuccessBrush}"/>
                                            <TextBlock x:Name="AutoSaveText" Text="Otomatik kayıt açık" Margin="7,0,0,0"
                                                       FontSize="11.5" Foreground="{StaticResource Text2Brush}"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Style="{StaticResource GhostButton}" Click="Recommended_Click" AutomationProperties.Name="Önerilen ayarlar"
                                            ToolTip="Aydınlık 55 · Kontrast 55 · Gama 1,10 · Canlılık 85">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE734;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Ember400Brush}"/>
                                            <TextBlock Text="Önerilen ayarlar" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" Click="Reset_Click" AutomationProperties.Name="Varsayılana dön">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7A7;" Style="{StaticResource Icon}" FontSize="12"/>
                                            <TextBlock Text="Varsayılana dön" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Ton eğrisi -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Ton eğrisi" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="Profilin ekrana etkisinin canlı görünümü" Style="{StaticResource CardSub}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <Ellipse Width="7" Height="7" Fill="#FF5A5F" VerticalAlignment="Center"/>
                                            <TextBlock Text="R" Margin="5,0,12,0" FontSize="11.5" Foreground="{StaticResource Text2Brush}"/>
                                            <Ellipse Width="7" Height="7" Fill="#3DD68C" VerticalAlignment="Center"/>
                                            <TextBlock Text="G" Margin="5,0,12,0" FontSize="11.5" Foreground="{StaticResource Text2Brush}"/>
                                            <Ellipse Width="7" Height="7" Fill="#4C9BFF" VerticalAlignment="Center"/>
                                            <TextBlock Text="B" Margin="5,0,0,0" FontSize="11.5" Foreground="{StaticResource Text2Brush}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,16,0,0" Height="200">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.15*"/>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource StrokeBrush}"
                                                BorderThickness="1" CornerRadius="12">
                                            <c:CurveView x:Name="Curve"/>
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="ÖNCE" Style="{StaticResource Eyebrow}"/>
                                            <Border x:Name="GrayBefore" Height="22" CornerRadius="8,8,0,0" Margin="0,8,0,0"/>
                                            <Border x:Name="ColorBefore" Height="22" CornerRadius="0,0,8,8"/>
                                            <TextBlock Text="SONRA" Style="{StaticResource Eyebrow}" Margin="0,18,0,0"/>
                                            <Border x:Name="GrayAfter" Height="22" CornerRadius="8,8,0,0" Margin="0,8,0,0"/>
                                            <Border x:Name="ColorAfter" Height="22" CornerRadius="0,0,8,8"/>
                                            <TextBlock Margin="0,12,0,0" FontSize="11.5" Foreground="{StaticResource Text3Brush}" TextWrapping="Wrap"
                                                       Text="Renk şeridi Digital Vibrance ve renk tonunu gösterir."/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Temel görüntü -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Temel görüntü" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="Aydınlık, kontrast ve gama" Style="{StaticResource CardSub}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Border Style="{StaticResource Chip}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="8,3">
                                            <TextBlock Text="WINDOWS RENK MOTORU" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Text2Brush}"/>
                                        </Border>
                                    </Grid>
                                    <StackPanel x:Name="BasicSliders" Margin="0,10,0,0"/>
                                    <TextBlock Margin="0,6,0,0" FontSize="11.5" Foreground="{StaticResource Text3Brush}" TextWrapping="Wrap"
                                               Text="Gama, Windows gama rampasıyla uygulanır. Hibrit grafikli dizüstüne bağlı harici monitör gibi bazı ekranlarda etkisizdir; orta tonları açmak için Aydınlık'ı kullanın."/>
                                </StackPanel>
                            </Border>

                            <!-- Renk canlılığı -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Renk canlılığı" Style="{StaticResource CardTitle}"/>
                                            <TextBlock x:Name="VibranceSubText" Text="Digital Vibrance ve renk tonu" Style="{StaticResource CardSub}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Border x:Name="NvidiaLayerChip" Style="{StaticResource Chip}" HorizontalAlignment="Right"
                                                VerticalAlignment="Top" Padding="8,3">
                                            <TextBlock x:Name="NvidiaLayerText" Text="WINDOWS RENK MOTORU" FontSize="10.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Text2Brush}"/>
                                        </Border>
                                    </Grid>
                                    <StackPanel x:Name="VibranceSliders" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- RGB -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,4">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="RGB kanalları" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="Renk dengesini kanal kanal ayarlayın" Style="{StaticResource CardSub}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Border Style="{StaticResource Chip}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="8,3">
                                            <TextBlock Text="WINDOWS RENK MOTORU" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Text2Brush}"/>
                                        </Border>
                                    </Grid>
                                    <StackPanel x:Name="RgbSliders" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ============ Eylem çubuğu ============ -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="FooterDot" Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{StaticResource Text3Brush}"/>
                            <TextBlock x:Name="FooterText" Grid.Column="1" Margin="10,0,16,0" Text="Hazır"
                                       Foreground="{StaticResource Text2Brush}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="PreviewButton" Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                    Click="Preview_Click" MinWidth="176" AutomationProperties.Name="Önizle">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="PreviewGlyph" Text="&#xE768;" Style="{StaticResource Icon}" FontSize="12"/>
                                    <TextBlock x:Name="PreviewText" Text="10 sn önizle" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="SaveButton" Grid.Column="3" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                                    Click="Save_Click" MinWidth="176" AutomationProperties.Name="Profili kaydet">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="SaveGlyph" Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="12"/>
                                    <TextBlock x:Name="SaveText" Text="Profili kaydet" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============ Diğer sayfalar (kodla eklenir) ============ -->
                <Grid x:Name="PageHost" Grid.Column="2"/>

                <!-- ============ Bildirim balonu ============ -->
                <Border x:Name="Toast" Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                        Margin="0,0,12,14" Padding="16,11" CornerRadius="12" MaxWidth="760"
                        Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource StrokeStrongBrush}"
                        BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ToastDot" Width="8" Height="8" VerticalAlignment="Center" Fill="{StaticResource SuccessBrush}"/>
                        <TextBlock x:Name="ToastText" Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="700"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
